{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subject.schema.json",
  "title": "MSc Structural Subject",
  "type": "object",
  "required": [
    "course_id",
    "curriculum_title",
    "status"
  ],
  "properties": {
    "course_id": {
      "type": "string"
    },
    "curriculum_title": {
      "type": "string"
    },
    "semester": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4
    },
    "semester_eligibility": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      }
    },
    "credit_hours": {
      "type": "number"
    },
    "catalog_type": {
      "enum": [
        "core",
        "thesis",
        "elective_catalog_I_II",
        "elective_catalog_III_IV_V"
      ]
    },
    "status": {
      "type": "string"
    },
    "workspace_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Private stable reference stored only in governed Drive registries; public records may omit it."
    }
  }
}